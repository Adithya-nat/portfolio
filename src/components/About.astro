---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="about section" id="about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2 class="section-title animate-on-scroll">About Me</h2>
        
        <div class="about-description animate-on-scroll animate-delay-1">
          <p class="about-lead">
            I'm a software engineer passionate about building systems that are both 
            <strong>intelligent</strong> and <strong>reliable</strong> at scale.
          </p>
          
          <p>
            At Intuit, I've led the development of AI-assisted security platforms, 
            including a multi-agent system for automated threat modeling that's now 
            deployed across all product security reviews. My work spans from designing 
            RAG-powered knowledge services to building real-time abuse prevention 
            systems that protect millions of daily transactions.
          </p>
          
          <p>
            I thrive at the intersection of <strong>AI/ML systems</strong> and 
            <strong>distributed backend architecture</strong>, where I can apply my 
            expertise in LangGraph, RAG pipelines, and event-driven systems to solve 
            complex problems. Whether it's orchestrating multi-agent workflows or 
            building high-throughput stream processing pipelines, I'm driven by the 
            challenge of creating systems that scale.
          </p>
        </div>
        
        <div class="about-highlights animate-on-scroll animate-delay-2">
          <div class="highlight-item">
            <div class="highlight-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                <path d="M2 17l10 5 10-5"/>
                <path d="M2 12l10 5 10-5"/>
              </svg>
            </div>
            <div class="highlight-content">
              <h4>AI & LLM Systems</h4>
              <p>Multi-agent architectures, RAG pipelines, and LangGraph orchestration</p>
            </div>
          </div>
          
          <div class="highlight-item">
            <div class="highlight-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
                <line x1="8" y1="21" x2="16" y2="21"/>
                <line x1="12" y1="17" x2="12" y2="21"/>
              </svg>
            </div>
            <div class="highlight-content">
              <h4>Distributed Systems</h4>
              <p>Event-driven architectures, stream processing, and microservices</p>
            </div>
          </div>
          
          <div class="highlight-item">
            <div class="highlight-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
            </div>
            <div class="highlight-content">
              <h4>Security & Compliance</h4>
              <p>Threat modeling, abuse prevention, and security-first design</p>
            </div>
          </div>
        </div>
      </div>
      
      <div class="about-sidebar animate-on-scroll animate-delay-3">
        <!-- Profile Photo -->
        <div class="sidebar-profile">
          <div class="profile-image-rounded">
            <img src={`${baseUrl}images/profile.png`} alt="Adithya Natarajan" loading="lazy" />
          </div>
        </div>
        
        <div class="sidebar-card">
          <h4>Currently</h4>
          <p>Software Engineer II at Intuit, building AI-powered security platforms</p>
        </div>
        
        <div class="sidebar-card">
          <h4>Location</h4>
          <p>Mountain View, CA</p>
        </div>
        
        <div class="sidebar-card">
          <h4>Focus Areas</h4>
          <div class="focus-tags">
            <span class="tag">AI/LLM</span>
            <span class="tag">Backend</span>
            <span class="tag">Security</span>
            <span class="tag">Distributed Systems</span>
          </div>
        </div>
        
        <div class="sidebar-card">
          <h4>Looking For</h4>
          <p>Senior SWE roles in backend systems, AI infrastructure, or platform engineering</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: var(--color-background-alt);
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--spacing-4xl);
    align-items: start;
  }

  .about-text {
    max-width: var(--max-width-text);
  }

  .about-description {
    margin-bottom: var(--spacing-2xl);
  }

  .about-lead {
    font-size: var(--font-size-xl);
    color: var(--color-text-primary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-lg);
  }

  .about-description p {
    margin-bottom: var(--spacing-md);
  }

  .about-description p:last-child {
    margin-bottom: 0;
  }

  .about-description strong {
    color: var(--color-text-primary);
    font-weight: var(--font-weight-semibold);
  }

  .about-highlights {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
  }

  .highlight-item {
    display: flex;
    gap: var(--spacing-md);
    padding: var(--spacing-lg);
    background-color: var(--color-surface);
    border-radius: var(--border-radius-md);
    border: 1px solid var(--color-border-light);
    transition: all var(--transition-base);
  }

  .highlight-item:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .highlight-icon {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-md);
    color: var(--color-accent);
  }

  .highlight-content h4 {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--spacing-xs);
  }

  .highlight-content p {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    margin: 0;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-lg);
    position: sticky;
    top: calc(var(--nav-height) + var(--spacing-xl));
  }

  .sidebar-profile {
    margin-bottom: var(--spacing-sm);
  }

  .profile-image-rounded {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-md);
    transition: all var(--transition-base);
  }

  .profile-image-rounded:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .profile-image-rounded img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sidebar-card {
    padding: var(--spacing-lg);
    background-color: var(--color-surface);
    border-radius: var(--border-radius-md);
    border: 1px solid var(--color-border-light);
  }

  .sidebar-card h4 {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-sm);
  }

  .sidebar-card p {
    font-size: var(--font-size-sm);
    color: var(--color-text-primary);
    margin: 0;
    line-height: var(--line-height-normal);
  }

  .focus-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .tag {
    display: inline-block;
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  @media (max-width: 1024px) {
    .about-content {
      grid-template-columns: 1fr;
      gap: var(--spacing-2xl);
    }

    .about-sidebar {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--spacing-lg);
    }

    .sidebar-profile {
      grid-column: span 2;
      max-width: 300px;
      margin: 0 auto var(--spacing-md);
    }

    .sidebar-card {
      flex: 1;
      min-width: 200px;
    }
  }

  @media (max-width: 768px) {
    .about-sidebar {
      grid-template-columns: 1fr;
    }

    .sidebar-profile {
      grid-column: span 1;
      max-width: 250px;
    }

    .sidebar-card {
      min-width: auto;
    }
  }
</style>
