---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

interface Certification {
  name: string;
  issuer: string;
  date: string;
  logo: string;
  credentialUrl?: string;
  description?: string;
}

const certifications: Certification[] = [
  {
    name: 'AWS Certified Solutions Architect',
    issuer: 'Amazon Web Services',
    date: 'January 2026',
    logo: `${baseUrl}images/aws-badge.png`,
    description: 'Associate-level certification validating expertise in designing distributed systems on AWS, including compute, storage, databases, and security best practices.',
  },
];
---

<section class="certifications section" id="certifications">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">Certifications</h2>
      <p class="section-subtitle">
        Professional credentials validating expertise in cloud architecture
      </p>
    </div>
    
    <div class="certifications-grid">
      {certifications.map((cert, index) => (
        <div class="certification-card animate-on-scroll" style={`--delay: ${index * 150}ms`}>
          <div class="cert-badge">
            <img src={cert.logo} alt={`${cert.name} badge`} loading="lazy" />
          </div>
          
          <div class="cert-content">
            <div class="cert-header">
              <h3 class="cert-name">{cert.name}</h3>
              <span class="cert-level">Associate</span>
            </div>
            
            <div class="cert-meta">
              <span class="cert-issuer">{cert.issuer}</span>
              <span class="cert-date">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
                {cert.date}
              </span>
            </div>
            
            {cert.description && (
              <p class="cert-description">{cert.description}</p>
            )}
          </div>
          
          <div class="cert-verification">
            <div class="verified-badge">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
              </svg>
              Verified
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .certifications {
    background-color: var(--color-background);
  }

  .certifications-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-2xl);
  }

  .certification-card {
    display: flex;
    gap: var(--spacing-xl);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    position: relative;
    transition: all var(--transition-base);
    transition-delay: var(--delay, 0ms);
  }

  .certification-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .cert-badge {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--border-radius-lg);
  }

  .cert-badge img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .cert-content {
    flex: 1;
    min-width: 0;
  }

  .cert-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .cert-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .cert-level {
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: #FF9900;
    color: white;
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    text-transform: uppercase;
  }

  .cert-meta {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-md);
    flex-wrap: wrap;
  }

  .cert-issuer {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .cert-date {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .cert-description {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin: 0;
  }

  .cert-verification {
    position: absolute;
    top: var(--spacing-lg);
    right: var(--spacing-lg);
  }

  .verified-badge {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: #ECFDF5;
    color: #059669;
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
  }

  @media (max-width: 768px) {
    .certifications-grid {
      grid-template-columns: 1fr;
    }

    .certification-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .cert-header {
      justify-content: center;
    }

    .cert-meta {
      justify-content: center;
    }

    .cert-verification {
      position: static;
      margin-top: var(--spacing-md);
    }
  }
</style>
