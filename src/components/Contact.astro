---
const baseUrl = import.meta.env.BASE_URL;

const contactLinks = [
  {
    name: 'Email',
    value: 'adithyanat26@gmail.com',
    href: 'mailto:adithyanat26@gmail.com',
    icon: 'mail',
  },
  {
    name: 'LinkedIn',
    value: 'linkedin.com/in/adithyanat',
    href: 'https://linkedin.com/in/adithyanat',
    icon: 'linkedin',
  },
  {
    name: 'GitHub',
    value: 'github.com/Adithya-nat',
    href: 'https://github.com/Adithya-nat',
    icon: 'github',
  },
];

const iconPaths: Record<string, string> = {
  mail: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2zM22 6l-10 7L2 6',
  linkedin: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 1 0-4 2 2 0 0 1 0 4z',
  github: 'M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22',
};
---

<section class="contact section" id="contact">
  <div class="container">
    <div class="contact-content">
      <div class="contact-text animate-on-scroll">
        <h2 class="contact-title">Let's Build Something Together</h2>
        <p class="contact-description">
          I'm currently exploring new opportunities in backend systems, AI infrastructure, 
          and platform engineering. If you're looking for someone who can build scalable, 
          intelligent systems, I'd love to hear from you.
        </p>
      </div>
      
      <div class="contact-links animate-on-scroll animate-delay-1">
        {contactLinks.map(link => (
          <a 
            href={link.href}
            class="contact-link"
            target={link.name !== 'Email' ? '_blank' : undefined}
            rel={link.name !== 'Email' ? 'noopener noreferrer' : undefined}
          >
            <div class="link-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPaths[link.icon]} />
              </svg>
            </div>
            <div class="link-content">
              <span class="link-name">{link.name}</span>
              <span class="link-value">{link.value}</span>
            </div>
            <div class="link-arrow">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"/>
                <polyline points="7 7 17 7 17 17"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
      
      <div class="contact-cta animate-on-scroll animate-delay-2">
        <a href="mailto:adithyanat26@gmail.com" class="btn btn-primary btn-large">
          Get In Touch
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </a>
        <a href={`${baseUrl}/resume.pdf`} class="btn btn-secondary btn-large" target="_blank" rel="noopener">
          Download Resume
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    background-color: var(--color-background-alt);
  }

  .contact-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .contact-text {
    margin-bottom: var(--spacing-3xl);
  }

  .contact-title {
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-lg);
  }

  .contact-description {
    font-size: var(--font-size-lg);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-2xl);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--spacing-lg);
    padding: var(--spacing-lg) var(--spacing-xl);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-lg);
    text-decoration: none;
    transition: all var(--transition-base);
  }

  .contact-link:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-md);
    transform: translateX(8px);
  }

  .link-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-md);
    color: var(--color-accent);
    flex-shrink: 0;
    transition: all var(--transition-base);
  }

  .contact-link:hover .link-icon {
    background-color: var(--color-accent);
    color: var(--color-surface);
  }

  .link-content {
    flex: 1;
    text-align: left;
  }

  .link-name {
    display: block;
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    margin-bottom: var(--spacing-xs);
  }

  .link-value {
    display: block;
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
  }

  .link-arrow {
    color: var(--color-text-muted);
    transition: all var(--transition-fast);
  }

  .contact-link:hover .link-arrow {
    color: var(--color-text-primary);
    transform: translate(4px, -4px);
  }

  .contact-cta {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    flex-wrap: wrap;
  }

  .btn-large {
    padding: var(--spacing-lg) var(--spacing-2xl);
    font-size: var(--font-size-base);
  }

  @media (max-width: 768px) {
    .contact-title {
      font-size: var(--font-size-3xl);
    }

    .contact-link {
      padding: var(--spacing-md);
    }

    .link-icon {
      width: 40px;
      height: 40px;
    }

    .contact-cta {
      flex-direction: column;
    }

    .btn-large {
      width: 100%;
      justify-content: center;
    }
  }
</style>
