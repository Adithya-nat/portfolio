---
const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

interface EducationItem {
  institution: string;
  logo: string;
  degree: string;
  field: string;
  location: string;
  dateRange: string;
  gpa: string;
  highlights?: string[];
  photo?: string;
  photoAlt?: string;
}

const education: EducationItem[] = [
  {
    institution: 'Arizona State University',
    logo: `${baseUrl}images/asu-logo.png`,
    degree: 'Master of Science',
    field: 'Computer Science',
    location: 'Tempe, AZ',
    dateRange: 'Aug 2021 — Dec 2022',
    gpa: '3.60/4.00',
    highlights: [
      'Focus on distributed systems and machine learning',
      'Graduate coursework in advanced algorithms and AI',
    ],
    photo: `${baseUrl}images/asu-campus.jpg`,
    photoAlt: 'Arizona State University campus',
  },
  {
    institution: 'SASTRA University',
    logo: `${baseUrl}images/sastra-logo.png`,
    degree: 'Bachelor of Technology',
    field: 'Computer Science & Engineering',
    location: 'India',
    dateRange: 'July 2016 — May 2020',
    gpa: '7.67/10',
    highlights: [
      'Strong foundation in computer science fundamentals',
      'Coursework in data structures, algorithms, and software engineering',
    ],
  },
];
---

<section class="education section" id="education">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">Education</h2>
      <p class="section-subtitle">
        Academic foundation in computer science from leading institutions
      </p>
    </div>
    
    <div class="education-grid">
      {education.map((item, index) => (
        <div class="education-card animate-on-scroll" style={`--delay: ${index * 150}ms`}>
          <div class="card-left">
            <div class="institution-logo">
              <img src={item.logo} alt={`${item.institution} logo`} loading="lazy" />
            </div>
          </div>
          
          <div class="card-content">
            <div class="card-header">
              <h3 class="institution-name">{item.institution}</h3>
              <span class="date-badge">{item.dateRange}</span>
            </div>
            
            <div class="degree-info">
              <h4 class="degree">{item.degree} in {item.field}</h4>
              <div class="meta">
                <span class="location">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                  {item.location}
                </span>
                <span class="gpa">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                  </svg>
                  GPA: {item.gpa}
                </span>
              </div>
            </div>
            
            {item.highlights && item.highlights.length > 0 && (
              <ul class="highlights">
                {item.highlights.map(highlight => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            
            {item.photo && (
              <div class="inline-photo">
                <img src={item.photo} alt={item.photoAlt || `Photo from ${item.institution}`} loading="lazy" />
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .education {
    background-color: var(--color-background-alt);
  }

  .education-grid {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
    margin-top: var(--spacing-2xl);
  }

  .education-card {
    display: flex;
    gap: var(--spacing-xl);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    transition: all var(--transition-base);
    transition-delay: var(--delay, 0ms);
  }

  .education-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-lg);
    transform: translateX(8px);
  }

  .card-left {
    flex-shrink: 0;
  }

  /* Larger logo styling */
  .institution-logo {
    width: 80px;
    height: 80px;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    background-color: var(--color-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border-light);
    box-shadow: var(--shadow-sm);
  }

  .institution-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 10px;
  }

  .card-content {
    flex: 1;
  }

  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .institution-name {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
  }

  .date-badge {
    padding: var(--spacing-xs) var(--spacing-md);
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  .degree-info {
    margin-bottom: var(--spacing-md);
  }

  .degree {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-sm);
  }

  .meta {
    display: flex;
    gap: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .location,
  .gpa {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-top: var(--spacing-md);
    border-top: 1px solid var(--color-border-light);
  }

  .highlights li {
    position: relative;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .highlights li:last-child {
    margin-bottom: 0;
  }

  .highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    background-color: var(--color-accent);
    border-radius: 50%;
  }

  /* Inline photo styling */
  .inline-photo {
    width: 100%;
    height: 200px;
    border-radius: var(--border-radius-md);
    overflow: hidden;
    margin-top: var(--spacing-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--color-border-light);
  }

  .inline-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .inline-photo:hover img {
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    .education-card {
      flex-direction: column;
      gap: var(--spacing-lg);
    }

    .institution-logo {
      width: 64px;
      height: 64px;
    }

    .card-header {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .inline-photo {
      height: 160px;
    }
  }
</style>
