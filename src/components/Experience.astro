---
import Timeline from './Timeline.astro';
import type { TimelineItem } from './Timeline.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;

const experienceItems: TimelineItem[] = [
  {
    id: 'intuit-swe2',
    company: 'Intuit Inc',
    logo: `${baseUrl}images/intuit-logo.svg`,
    role: 'Software Engineer 2',
    location: 'Mountain View, CA',
    dateRange: 'Jan 2024 — Present',
    highlights: [
      'Architected and developed Secure Design Agent, a multi-agent AI system (LangGraph/Python) deployed across all product security reviews, orchestrating RAI Planner, Code Analysis, and Architecture Analysis agents with ReAct retry logic',
      'Built Reviewer Experience Service (Java/Spring Boot) powering AI agent workflows: agent status tracking, prompt/version management, similarity scoring for threat assessments, and PostgreSQL-backed review lifecycle management',
      'Developed RAG Knowledge Service (Python/FastAPI) with vector search, enabling semantic retrieval of security docs using embeddings and OpenSearch',
      'Designed and shipped Rate Shield, a centralized rate limiting microservice (Spring Boot, DynamoDB, Bucket4j) protecting 5M+ daily email and SMS transactions across QuickBooks',
      'Architected AppConnectGuard, a real-time 3P abuse detection service processing 1-2M daily events via Numaflow stream processing',
      'Led 3P abuse detection pipeline with NeLi auto-labeling and ThreatMetrix ML-based risk scoring integrated into STRA rules engine',
    ],
    technologies: ['LangGraph', 'Python', 'FastAPI', 'Java', 'Spring Boot', 'OpenSearch', 'Kafka', 'DynamoDB', 'AWS'],
    photo: `${baseUrl}images/intuit-office.jpg`,
    photoAlt: 'Intuit office in Mountain View, CA',
  },
  {
    id: 'intuit-swe1',
    company: 'Intuit Inc',
    logo: `${baseUrl}images/intuit-logo.svg`,
    role: 'Software Engineer 1',
    location: 'Mountain View, CA',
    dateRange: 'Jan 2023 — Jan 2024',
    highlights: [
      'Architected end-to-end SMS Screening system (100K+ daily, 100 peak TPS) with Bucket4j rate limiting, Drools eligibility workflows, and Kafka event publishing',
      'Optimized QBDT latency via feature-flagged DynamoDB caching; pioneered GenAI integration for automated asset classification',
      'Automated Jira workflows including priority assignment and lifecycle tracking, reducing manual triage overhead by 50%',
      'Built WireMock-based integration testing framework; led JS to TypeScript migration and Cypress v12 upgrade',
    ],
    technologies: ['Java', 'Spring Boot', 'Drools', 'Kafka', 'DynamoDB', 'TypeScript', 'Cypress'],
  },
  {
    id: 'intuit-intern',
    company: 'Intuit Inc',
    logo: `${baseUrl}images/intuit-logo.svg`,
    role: 'Software Engineer Intern',
    location: 'Mountain View, CA',
    dateRange: 'May 2022 — Aug 2022',
    highlights: [
      'Built security review portal (Java/Spring Boot, Thymeleaf) with AWS Athena integration for fraud analytics',
      'Added validation, tests, and admin-configurable mitigation rules to support review operations',
    ],
    technologies: ['Java', 'Spring Boot', 'AWS Athena', 'Thymeleaf'],
  },
  {
    id: 'freshworks-swe',
    company: 'Freshworks',
    logo: `${baseUrl}images/freshworks-logo.png`,
    role: 'Software Engineer',
    location: 'Chennai, India',
    dateRange: 'Oct 2020 — July 2021',
    highlights: [
      'Developed Node.js backend for Freshworks Marketplace and shipped crash alerting system notifying developers when app crashes exceed thresholds',
      'Built REST APIs (App Installations, Custom Objects) using Express.js',
      'Re-architected database schemas (MySQL, DynamoDB, Redis) reducing latency',
      'Published Freshdesk SDK, an NPM package enabling developers to integrate with Freshdesk APIs',
    ],
    technologies: ['Node.js', 'Express.js', 'MySQL', 'DynamoDB', 'Redis'],
  },
  {
    id: 'freshworks-intern',
    company: 'Freshworks',
    logo: `${baseUrl}images/freshworks-logo.png`,
    role: 'Software Engineer Intern',
    location: 'Chennai, India',
    dateRange: 'Dec 2019 — Sep 2020',
    highlights: [
      'Integrated SonarQube CI checks across repositories with unit tests (Node.js, Mocha.js)',
      'Built DynamoDB table with TTL-based data retention for compliance',
    ],
    technologies: ['Node.js', 'Mocha.js', 'SonarQube', 'DynamoDB'],
  },
];
---

<section class="experience section" id="experience">
  <div class="container">
    <Timeline 
      items={experienceItems}
      title="Work Experience"
      subtitle="Building scalable systems and AI-powered platforms at industry-leading companies"
    />
  </div>
</section>

<style>
  .experience {
    background-color: var(--color-background);
  }
</style>
