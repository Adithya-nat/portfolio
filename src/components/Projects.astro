---
interface Project {
  title: string;
  description: string;
  highlights: string[];
  technologies: string[];
  githubUrl: string;
  featured?: boolean;
}

const projects: Project[] = [
  {
    title: 'AI Short Form Content Agent',
    description: 'An AI-powered video pipeline that orchestrates multiple AI services to automatically generate short-form video content.',
    highlights: [
      'Built FastAPI backend with WebSocket progress tracking for real-time updates',
      'Orchestrates GPT-4o for script generation, DALL-E for images, and TTS for narration',
      'Uses MoviePy and FFmpeg for professional video composition',
      'Fully automated pipeline from prompt to finished video',
    ],
    technologies: ['Python', 'FastAPI', 'GPT-4o', 'DALL-E', 'MoviePy', 'FFmpeg', 'WebSocket'],
    githubUrl: 'https://github.com/Adithya-nat/ai-reels-agent',
    featured: true,
  },
  {
    title: 'Job Search Automation Tool',
    description: 'A full-stack application that automates the job search process with AI-generated tailored applications.',
    highlights: [
      'React frontend with Express.js backend and MongoDB for data persistence',
      'Generates tailored resumes and cover letters using LLMs',
      'Puppeteer-based web scraping for job listings',
      'Slack integration for real-time job notifications',
    ],
    technologies: ['React', 'Express.js', 'MongoDB', 'LLMs', 'Puppeteer', 'Slack API'],
    githubUrl: 'https://github.com/Adithya-nat/job-automation-tool',
    featured: true,
  },
];
---

<section class="projects section" id="projects">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">Personal Projects</h2>
      <p class="section-subtitle">
        Side projects where I explore new technologies and solve interesting problems
      </p>
    </div>
    
    <div class="projects-grid">
      {projects.map((project, index) => (
        <article class="project-card animate-on-scroll" style={`--delay: ${index * 150}ms`}>
          <div class="project-content">
            <div class="project-header">
              <h3 class="project-title">{project.title}</h3>
              <a 
                href={project.githubUrl} 
                class="github-link"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View on GitHub"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                </svg>
              </a>
            </div>
            
            <p class="project-description">{project.description}</p>
            
            <ul class="project-highlights">
              {project.highlights.map(highlight => (
                <li>{highlight}</li>
              ))}
            </ul>
            
            <div class="project-tech">
              {project.technologies.map(tech => (
                <span class="tech-badge">{tech}</span>
              ))}
            </div>
          </div>
          
          <a 
            href={project.githubUrl} 
            class="project-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            View Project
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="7" y1="17" x2="17" y2="7"/>
              <polyline points="7 7 17 7 17 17"/>
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects {
    background-color: var(--color-background);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: var(--spacing-xl);
    margin-top: var(--spacing-2xl);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    transition: all var(--transition-base);
    transition-delay: var(--delay, 0ms);
  }

  .project-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-xl);
    transform: translateY(-6px);
  }

  .project-content {
    flex: 1;
    padding: var(--spacing-xl);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-md);
  }

  .project-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-primary);
    line-height: var(--line-height-snug);
  }

  .github-link {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    border-radius: var(--border-radius-md);
    transition: all var(--transition-fast);
  }

  .github-link:hover {
    color: var(--color-text-primary);
    background-color: var(--color-background-alt);
  }

  .project-description {
    font-size: var(--font-size-base);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-lg);
  }

  .project-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--spacing-lg) 0;
  }

  .project-highlights li {
    position: relative;
    padding-left: var(--spacing-lg);
    margin-bottom: var(--spacing-sm);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  .project-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 9px;
    width: 6px;
    height: 6px;
    background-color: var(--color-highlight);
    border-radius: 50%;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .tech-badge {
    padding: var(--spacing-xs) var(--spacing-sm);
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-sm);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
  }

  .project-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
    background-color: var(--color-background-alt);
    border-top: 1px solid var(--color-border-light);
    color: var(--color-text-primary);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .project-link:hover {
    background-color: var(--color-text-primary);
    color: var(--color-background);
  }

  .project-link svg {
    transition: transform var(--transition-fast);
  }

  .project-link:hover svg {
    transform: translate(2px, -2px);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
