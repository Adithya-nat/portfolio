---
interface SkillCategory {
  title: string;
  icon: string;
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    title: 'Languages',
    icon: 'code',
    skills: ['Java', 'Python', 'TypeScript', 'JavaScript'],
  },
  {
    title: 'Backend & APIs',
    icon: 'server',
    skills: ['Spring Boot', 'FastAPI', 'Node.js', 'Express.js', 'Kafka', 'Drools'],
  },
  {
    title: 'AI & LLM',
    icon: 'brain',
    skills: ['LangGraph', 'LangChain', 'RAG', 'Vector Search', 'OpenSearch', 'Langfuse'],
  },
  {
    title: 'Cloud & Infrastructure',
    icon: 'cloud',
    skills: ['AWS Lambda', 'AWS CDK', 'DynamoDB', 'PostgreSQL', 'Redis', 'Docker', 'Kubernetes'],
  },
  {
    title: 'Testing & CI/CD',
    icon: 'test',
    skills: ['Cypress', 'WireMock', 'Mocha.js', 'Jenkins', 'SonarQube'],
  },
];

const iconPaths: Record<string, string> = {
  code: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
  server: 'M2 17h20M2 12h20M2 7h20M6 17v4M6 3v4M18 17v4M18 3v4',
  brain: 'M12 2a9 9 0 0 0-9 9c0 3.6 2.4 6.5 5.5 7.5l.5.5V22h6v-3l.5-.5c3.1-1 5.5-3.9 5.5-7.5a9 9 0 0 0-9-9zM9 10h.01M15 10h.01',
  cloud: 'M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z',
  test: 'M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
};
---

<section class="skills section" id="skills">
  <div class="container">
    <div class="section-header animate-on-scroll">
      <h2 class="section-title">Technical Skills</h2>
      <p class="section-subtitle">
        Technologies and tools I use to build scalable, intelligent systems
      </p>
    </div>
    
    <div class="skills-grid">
      {skillCategories.map((category, index) => (
        <div class="skill-card animate-on-scroll" style={`--delay: ${index * 100}ms`}>
          <div class="skill-header">
            <div class="skill-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPaths[category.icon]} />
              </svg>
            </div>
            <h3 class="skill-title">{category.title}</h3>
          </div>
          
          <div class="skill-tags">
            {category.skills.map(skill => (
              <span class="skill-tag">{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    background-color: var(--color-background-alt);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
    margin-top: var(--spacing-2xl);
  }

  .skill-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: var(--border-radius-lg);
    padding: var(--spacing-xl);
    transition: all var(--transition-base);
    transition-delay: var(--delay, 0ms);
  }

  .skill-card:hover {
    border-color: var(--color-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-4px);
  }

  .skill-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-lg);
  }

  .skill-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-md);
    color: var(--color-accent);
    transition: all var(--transition-base);
  }

  .skill-card:hover .skill-icon {
    background-color: var(--color-accent);
    color: var(--color-surface);
  }

  .skill-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-primary);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-sm);
  }

  .skill-tag {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-md);
    background-color: var(--color-background-alt);
    border-radius: var(--border-radius-full);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-secondary);
    transition: all var(--transition-fast);
  }

  .skill-card:hover .skill-tag {
    background-color: var(--color-background);
  }

  @media (max-width: 768px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
